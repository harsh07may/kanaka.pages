# Postgres connection string (Vercel Postgres / Neon / any standard Postgres)
POSTGRES_URL=

# Random 32+ character secret used to encrypt the admin session cookie
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# bcrypt hash of the admin password
# Generate with: node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "your-password"
ADMIN_PASSWORD_HASH=
